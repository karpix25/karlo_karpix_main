# Backend
APP_NAME=VACA Backend
ENVIRONMENT=dev
DB_PATH=./backend/vaca.db
DEFAULT_LANGUAGE=ru

# Telegram auth (for production signature verification)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600
AUTH_ALLOW_INSECURE_DEV=true
ADMIN_USER_ID=0

# LLM provider: 9router | openrouter | openai
LLM_PROVIDER=openrouter

# Shared OpenAI-compatible defaults
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Generic OpenAI key (used directly for provider=openai, fallback for routers)
OPENAI_API_KEY=

# 9router
# Set your actual router host (example: https://router.karpix.com/v1)
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=https://api.9router.com/v1
NINE_ROUTER_MODEL=
NINE_ROUTER_HTTP_REFERER=
NINE_ROUTER_X_TITLE=VACA

# OpenRouter
OPENROUTER_API_KEY=https://www.instagram.com/reels/C48Ly0VoK18/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=VACA

# If a router returns "No active credentials for provider: ...",
# enable that provider in your router account or switch model/provider.

# Userbot
TELETHON_ENABLED=false
TELETHON_API_ID=0
TELETHON_API_HASH=
TELETHON_SESSION=vaca_userbot
USERBOT_SECRETS_KEY=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_ALLOW_INSECURE_DEV=true
